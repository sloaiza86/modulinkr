# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Build artefacts
*.o
*.obj
*.elf
*.bin
*.hex
*.map
*.lst

# Excepción deliberada: los binarios que el Pi sirve, que no son artefactos
# de compilación sino parte de lo que se despliega. Los generan los
# make_dist.sh y viajan con el scp del pi-service, o con el git clone en una
# instalación fresca: el instalador configura dependencias y systemd sobre el
# árbol que ya está, no copia código, así que lo que no esté versionado no
# llega al Pi.
#
#   heltec-radio.bin  firmware de la radio, se flashea en la instalación
#   nodo.bin          imagen completa del nodo, para flashear por USB desde
#                     la página "Cargar firmware"
#   nodo-app.bin      la aplicación sola, que es lo que se envía por LoRa
#                     (§18). Sin ella la actualización por radio no está
#                     disponible y el visor lo dice.
!gateway/pi-service/heltec-radio.bin
!gateway/pi-service/nodo.bin
!gateway/pi-service/nodo-app.bin

# Dependencias instaladas localmente
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Assets JS de terceros que baja get_vendor.sh (vis-network, ECharts,
# esptool-js). No se versionan: se descargan en la instalación con Internet.
gateway/pi-web/static/vendor/

# Secretos y credenciales (nunca commitear)
secrets.h
secrets.ini
credentials.json
.env
.env.*
!.env.example
# Config del instalador del servidor con valores rellenados (guarda secretos)
server/modulinkr-server.conf
server/config/modulinkr-server.conf
# Config MQTT del gateway con la clave del broker (se crea en el Pi, 600)
gateway/pi-service/mqtt.env
# Certificado y clave TLS del visor (autofirmados, se generan en el Pi)
gateway/pi-web/.tls/
# Config del instalador del gateway con valores rellenados (puede tener ajustes propios)
gateway/pi-service/installer/modulinkr-gateway.conf
gateway/pi-service/installer/config/modulinkr-gateway.conf

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editores
*.swp
*.swo
*~
.idea/

# Logs y dumps
*.log
*.dump
serial-capture-*.txt
