[Unit]
# ModuLinkr, servicio del gateway (lado Pi).
# El beacon del árbol de rutas depende de este proceso: si se cae, la red
# LoRa se queda sin raíz hasta que systemd lo relanza. Por eso Restart=always
# con un backoff corto.
#
# Unidad de referencia. La instalación normal la genera el instalador
# (installer/install.sh) con las rutas reales; este archivo sirve de plantilla
# y para instalaciones manuales. Toda la config y los secretos (network id,
# clave AES-CCM, credenciales MQTT) viven en /etc/modulinkr/gateway.env, que
# escribe el instalador con permisos de root. Aquí NO hay secretos.
Description=ModuLinkr gateway service (LoRa mesh root, ACK and beacon)
After=multi-user.target
Wants=network-online.target

[Service]
Type=simple
User=practica
Group=dialout
WorkingDirectory=/home/practica/pi-service

# Toda la config por entorno viene del archivo que escribe el instalador
# (MODULINKR_PORT, NETWORK_ID, DB, SEC_ENABLED, SEC_KEY, MQTT_*). El `-` deja
# arrancar el servicio aunque el archivo falte (útil solo para depurar).
EnvironmentFile=-/etc/modulinkr/gateway.env

# Venv dedicado del gateway (lo crea el instalador con pyserial, cryptography y
# paho-mqtt). En instalaciones manuales, ajustar la ruta al venv en uso.
ExecStart=/home/practica/pi-service/.venv/bin/python3 /home/practica/pi-service/gateway_service.py

Restart=always
RestartSec=2

# El servicio escribe a journald; se ve con: journalctl -u modulinkr-gateway -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
